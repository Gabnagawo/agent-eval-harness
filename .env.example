# ==============================================================================
# agent-eval-harness: Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
#
# Do NOT commit .env files containing real API keys or sensitive data.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider Configuration (CONTRACTS.md section 10)
# ------------------------------------------------------------------------------
# LLM provider to use for agent evaluation.
# Choices: ollama (default, zero cost), anthropic, openai
# LLM_PROVIDER=ollama

# Model name / identifier.
# Defaults to "qwen3:8b" when LLM_PROVIDER=ollama.
# For anthropic: "claude-sonnet-5-5"
# For openai: "gpt-4o-mini"
# LLM_MODEL=qwen3:8b

# ------------------------------------------------------------------------------
# Ollama Settings (CONTRACTS.md section 10)
# ------------------------------------------------------------------------------
# Base URL for the Ollama server.
# Default: http://localhost:11434 (use http://host.docker.internal:11434 in Docker)
# OLLAMA_HOST=http://localhost:11434

# Context window size in tokens for Ollama.
# Default: 16384
# OLLAMA_NUM_CTX=16384

# Low-RAM memory management: unload the model from VRAM/RAM every N tool calls.
# Recommended: 20 for 16GB machines; 0 disables unloading.
# OLLAMA_UNLOAD_EVERY=20

# Whether to force a model reload after a faulted call.
# OLLAMA_RELOAD_ON_FAULT=true

# ------------------------------------------------------------------------------
# Anthropic Settings (CONTRACTS.md section 10)
# ------------------------------------------------------------------------------
# API key for Anthropic provider (lazy-loaded extra).
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# OpenAI / OpenAI-compatible Settings (CONTRACTS.md section 10)
# ------------------------------------------------------------------------------
# API key for OpenAI or compatible endpoints (lazy-loaded extra).
# OPENAI_API_KEY=your_openai_api_key_here

# Base URL for OpenAI-compatible endpoints (e.g., local vLLM, LiteLLM, Ollama v1).
# Defaults to official OpenAI endpoint if unset.
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# General LLM Generation & Client Parameters
# ------------------------------------------------------------------------------
# Request timeout in seconds.
# LLM_TIMEOUT=180.0

# Maximum retry attempts on network/provider failure.
# LLM_MAX_RETRIES=2

# Maximum token generation per step.
# LLM_MAX_TOKENS=1024

# Sampling temperature (0.0 to 1.0).
# LLM_TEMPERATURE=0.7

# Top-p nucleus sampling.
# LLM_TOP_P=0.8

# Top-k sampling limit.
# LLM_TOP_K=20
